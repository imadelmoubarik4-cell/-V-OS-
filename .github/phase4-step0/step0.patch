+test('legacy UI loads the data gateway before its application bootstrap', () => {
+  const configIndex = index.indexOf('<script src="config.js"></script>');
+  const dataIndex = index.indexOf('<script src="assets/js/data/atlas-data.js"></script>');
+  const inlineIndex = index.indexOf('<script>\n  const SUPABASE_CDN_URLS');
+  assert.ok(configIndex >= 0);
+  assert.ok(dataIndex > configIndex);
+  assert.ok(inlineIndex > dataIndex);
+});
+
+
+test('legacy loaders fetch through AtlasData and render only after loading', () => {
+  assert.match(index, /AtlasData\.getActiveProfile/);
+  assert.match(index, /AtlasData\.getItems/);
+  assert.match(index, /AtlasData\.getInventoryMovements/);
+  assert.match(index, /AtlasData\.getRecipes/);
+  assert.match(index, /AtlasData\.getSuppliers/);
+  assert.match(index, /await Promise\.all\([\s\S]*renderTabs\(\);[\s\S]*renderTable\(\);/);
+});
