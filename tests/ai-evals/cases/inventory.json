      "evidence": [
        { "kind": "fact", "label": "Current stock of Tanqueray London Dry Gin", "value": "4 bottle (manager-verified count plus -1 in recorded movements since)" },
        { "kind": "fact", "label": "Package size", "value": "700 ml" },
        { "kind": "fact", "label": "Par level", "value": "6 bottle" }
      ],
      "records": ["inventory_item:@item.tanqueray"],
      "unknown": null
