  {
    "id": "inv-005", "category": "inventory", "blocking": true,
    "question": "Is anything below par?",
    "actor": "manager", "tool": "inventory.below_par",
    "args": { "category": null, "limit": null },
    "expected": {
      "ok": true,
      "summary": ["8 below par and 1 out of stock", "26 of 40 active items cannot be judged"],
      "data": {
        "data.counts.active_items": 40, "data.counts.current_items": 24, "data.counts.below_par": 8, "data.counts.out_of_stock": 1,
        "data.counts.missing_par": 24, "data.counts.par_but_unknown_stock": 2, "data.counts.undeterminable": 26,
        "data.out_of_stock": { "$some": { "name": "Aperol" } },
        "data.below_par": { "$len": 8 }
      },
      "evidence_kinds": ["fact", "calculation", "missing"],
      "evidence": [
        { "kind": "missing", "label": "Items with no par level", "value": "24 of 40 active items" },
        { "kind": "missing", "label": "Items with a par but no current count", "value": "2 items" },
        { "kind": "calculation", "label": "Angelo Pinot Grigio is below par", "value": "10 bottle verified < par 12" }
      ],
      "records": ["inventory_item:@item.aperol", "inventory_item:@item.angelo", "inventory_item:@item.limes"],
      "records_exclude": ["inventory_item:@item.jameson", "inventory_item:@item.whispering"],
      "unknown": { "count": 26, "breakdown": { "missing_par": 24, "par_but_unknown_stock": 2 } }
    },
    "notes": "Jameson (stale count) and Whispering Angel (never counted) have a par but no current count: never called low."
  },
