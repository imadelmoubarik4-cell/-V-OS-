[
  {
    "id": "inv-001", "category": "inventory", "blocking": true,
    "question": "How many bottles of Angelo Pinot Grigio do we have?",
    "actor": "manager", "tool": "inventory.current_stock",
    "args": { "item_ids": null, "query": "Angelo Pinot Grigio", "category": null, "limit": null },
    "expected": {
      "ok": true,
      "summary": ["1 of 1 matching items have verified stock"],
      "data": { "data.items[0].id": "@item.angelo", "data.items[0].quantity": 10, "data.items[0].quantity_status": "current", "data.items[0].par_level": 12 },
      "evidence_kinds": ["fact", "calculation"],
      "evidence": [{ "kind": "fact", "label": "Current stock of Angelo Pinot Grigio", "value": "10 bottle", "source": "inventory_item:@item.angelo" }],
      "records": ["inventory_item:@item.angelo"],
      "unknown": null, "proposal": null
    },
    "notes": "Verified count 10 (22 Sep); the raw imported quantity 40 must never be reported."
  },
  {
