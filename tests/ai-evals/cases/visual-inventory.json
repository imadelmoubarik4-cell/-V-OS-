  {
    "id": "vi-019", "category": "multimodal", "blocking": true, "world": "catalog",
    "question": "[photo of the back bar] Count these bottles",
    "actor": "bartender", "tool": "inventory.identify_from_image",
    "args": { "media_id": "@media.backBarBottles", "mode": "count", "purchase_order_id": null, "count_session_id": null },
    "expected": {
      "ok": true,
      "summary": ["3 products in the photo", "possibly Aperol", "about 4 bottles visible (estimated from the photo, 85% confidence)", "about 2 bottles visible", "Monin Lavender Syrup, not in Atlas", "about 3 bottles visible", "Nothing was changed", "stock count draft", "Inventory › Counts"],
      "summary_excludes": ["couldn't verify", "in stock"],
      "data": {
        "data.detections": { "$len": 3 },
        "data.detections[0].visible_units.value": 4,
        "data.detections[0].visible_units.confidence": 85,
        "data.detections[0].visible_units.estimate": true,
        "data.detections[0].candidates[0].name": "Aperol",
        "data.detections[1].visible_units.value": 2,
        "data.detections[1].candidates[0].name": "Campari",
        "data.detections[2].band": "low",
        "data.detections[2].in_atlas": false,
        "data.detections[2].read_name": "Monin Lavender Syrup",
        "data.detections[2].visible_units.value": 3,
        "data.detections": { "$every": { "preselected_item_id": null } },
        "data.next_steps[0].kind": "stock_count_draft",
        "data.next_steps[0].tool": "inventory.prepare_count",
        "data.next_steps[0].entries": { "$len": 2 },
        "data.next_steps[0].entries[0].item_id": "@item.aperol",
        "data.next_steps[0].entries[0].quantity": 4,
        "data.next_steps[0].entries[0].confirmed_match": false,
        "data.next_steps[0].entries[1].item_id": "@item.campari",
        "data.next_steps[0].entries[1].quantity": 2,
        "data.next_steps[1].route": "#inventory/counts",
        "data.stock_changed": false
      },
      "evidence_kinds": ["estimate", "interpretation"],
      "evidence": [
        { "kind": "estimate", "label": "Product 1: visible in the photo", "value": "about 4 bottles (estimated from the photo, 85% confidence)" },
        { "kind": "estimate", "label": "Product 3: visible in the photo", "value": "about 3 bottles" }
      ],
      "records": ["inventory_item:@item.aperol", "inventory_item:@item.campari"],
      "unknown": { "count": 1 },
      "proposal": null
    },
    "notes": "S91 'Count these bottles': visible counts are estimates from the photo with a confidence; the Lavender syrup is 'not in Atlas'; the next step is a stock count draft (only for products that match Atlas items, matches confirmed first) or Inventory › Counts. Nothing is proposed or changed by the photo itself."
  },
