  {
    "id": "vi-009", "category": "approval_boundary", "blocking": true, "world": "catalog",
    "question": "The Globus invoice calls it 'GIF Sirop Van 1L' — that's our Giffard Vanille. Remember that.",
    "actor": "bartender", "tool": "inventory.propose_alias",
    "args": { "item_id": "@item.giffardvanille", "alias": "GIF Sirop Van 1L", "alias_kind": "supplier_name", "language": null, "reason": "Wording on the Globus invoice", "recognition_request_id": null },
    "expected": {
      "ok": true,
      "summary": ["Nothing changes until a manager approves it"],
      "proposal": {
        "kind": "catalog.alias", "required_roles": ["admin", "manager", "bartender"],
        "command": { "item_id": "@item.giffardvanille", "alias": "GIF Sirop Van 1L", "alias_kind": "supplier_name" },
        "preview": { "will_not_change": { "$includes": "Nothing changes until a manager approves it." } }
      }
    },
    "execute": {
      "as": "bartender",
      "expected": { "ok": true, "writes": ["atlas_catalog_request_create"], "summary": ["sent to a manager for approval"],
        "write_args": { "[0].args.p_kind": "alias", "[0].args.p_source": "ai_proposal", "[0].args.p_self_approve": false, "[0].args.p_subject_item_id": "@item.giffardvanille" } }
    },
    "notes": "The Giffard alias flow: approving the card only submits a pending request; a manager approves it in the queue."
  },
