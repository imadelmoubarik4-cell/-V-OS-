[
  {
    "id": "vi-001", "category": "multimodal", "blocking": true, "world": "catalog",
    "question": "[photo of a syrup bottle] What is this and do we have it?",
    "actor": "bartender", "tool": "inventory.identify_from_image",
    "args": { "media_id": "@media.giffardVanille", "mode": "identify", "purchase_order_id": null, "count_session_id": null },
    "expected": {
      "ok": true,
      "summary": ["possibly Giffard Vanille Syrup", "ask which", "Nothing was changed"],
      "data": {
        "data.detections[0].band": "medium",
        "data.detections[0].preselected_item_id": null,
        "data.detections[0].candidates[0].name": "Giffard Vanille Syrup",
        "data.detections[0].candidates[0].explanation": { "$match": "^Candidate 1 — Giffard Vanille Syrup, \\d+%: .*\"GIFFARD\" detected.*\"VANILLE\" detected.*1 L detected.*bottle packaging detected" },
        "data.detections[0].field_confidence.brand": 97,
        "data.detections[0].field_confidence.unit_size": 72,
        "data.detections[0].field_confidence.barcode": 0,
        "data.stock_changed": false
      },
      "evidence_kinds": ["interpretation"],
      "evidence_kinds_absent": ["fact"],
      "records": ["inventory_item:@item.giffardvanille"]
    },
    "notes": "Owner §7: a label read without a barcode is Medium with evidence, never High and never pre-selected."
  },
