        "command": { "scope_type": "category", "scope_value": "Spirits", "title": "Atlas count 2026-09-24", "entries": [{ "item_id": "@item.tanqueray", "item_name": "Tanqueray London Dry Gin", "quantity": 6, "unit": "bottle", "note": null }, { "item_id": "@item.campari", "item_name": "Campari", "quantity": 2, "unit": "bottle", "note": null }] },
        "preview": { "will_not_change": { "$includes": "No direct stock adjustment is made." } }
      }
    }
