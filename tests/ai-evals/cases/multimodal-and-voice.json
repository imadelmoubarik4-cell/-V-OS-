[
  {
    "id": "mm-001", "category": "multimodal", "blocking": true,
    "question": "[photo of the Globus delivery note] Does this match our order?",
    "actor": "manager", "tool": "purchasing.compare_delivery",
    "args": { "purchase_order_id": "@po.globusOrdered", "observed": [{ "item_id": null, "name": "Aperol", "quantity": 12, "unit_cost": 3700 }, { "item_id": null, "name": "Cointreau", "quantity": 5, "unit_cost": null }, { "item_id": null, "name": "Campari", "quantity": 6, "unit_cost": null }], "note": null },
    "expected": {
      "ok": true,
      "summary": ["Globus delivery: 1 lines match, 3 discrepancies", "stock changes only if you approve it"],
      "data": {
        "data.lines[0]": { "name": "Aperol", "status": "match", "price_changed": true, "ordered_unit_cost": 3600, "observed_unit_cost": 3700 },
        "data.lines[1]": { "name": "Cointreau", "status": "short", "observed": 5, "remaining": 6, "to_receive": 5 },
        "data.unexpected": [{ "item_id": null, "name": "Campari", "quantity": 6 }],
        "data.discrepancies": { "$len": 3 }
      },
      "evidence": [
        { "kind": "calculation", "label": "Cointreau", "value": "5 delivered vs 6 outstanding (short)" },
        { "kind": "interpretation", "label": "Unexpected item: Campari", "value": "6 delivered but not on this order" },
        { "kind": "calculation", "label": "Price change: Aperol", "value": "3,700 ISK delivered vs 3,600 ISK ordered" }
      ],
      "proposal": {
        "kind": "purchase_order.receive", "required_roles": ["admin", "manager"],
        "command": { "p_version": 3, "p_receipt": [{ "item_id": "@item.aperol", "quantity": 12, "unit_cost": 3700, "note": null }, { "item_id": "@item.cointreau", "quantity": 5, "unit_cost": null, "note": null }] },
        "preview": { "will_not_change": { "$includes": "Unexpected items found in the delivery are not added." } }
      }
    },
    "notes": "Observed items as a vision model would extract them from the delivery photo."
  },
  {
    "id": "mm-002", "category": "multimodal", "blocking": true,
    "question": "[photo] Receive the Globus delivery as counted.",
    "actor": "manager", "tool": "purchasing.compare_delivery",
    "args": { "purchase_order_id": "@po.globusOrdered", "observed": [{ "item_id": "@item.aperol", "name": null, "quantity": 12, "unit_cost": null }, { "item_id": "@item.cointreau", "name": null, "quantity": 6, "unit_cost": null }], "note": "Checked against the delivery note photo" },
    "expected": { "ok": true, "data": { "data.discrepancies": { "$len": 0 } }, "proposal": { "kind": "purchase_order.receive" } },
    "execute": {
      "as": "manager",
      "expected": { "ok": true, "writes": ["atlas_purchase_order_command_v2"], "summary": ["2 lines posted to stock", "received"], "write_args": { "[0].args.p_action": "receive_lines", "[0].args.p_version": 3 } },
      "after": { "tool": "inventory.get", "args": { "item_id": "@item.aperol" }, "data": { "data.item.quantity": 12 } }
    },
    "notes": "Aperol stock (verified 0) becomes 12 only after the manager approves the receiving proposal."
  },
  {
