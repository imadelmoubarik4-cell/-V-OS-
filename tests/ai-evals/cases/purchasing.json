[
  {
    "id": "pur-001", "category": "purchasing", "blocking": true,
    "question": "What needs ordering before Friday?",
    "actor": "manager", "tool": "purchasing.suggest",
    "args": { "supplier_id": null, "include_ordered": null },
    "expected": {
      "ok": true,
      "summary": ["6 items to order across 4 supplier(s), estimated 222.960 kr", "3 more are already on open orders", "24 items have no par level and 2 have no current count"],
      "data": {
        "data.counts": { "suggested": 6, "already_ordered": 3, "missing_par": 24, "par_but_unknown_stock": 2 },
        "data.estimated_total": 222960,
        "data.groups": { "$len": 4 },
        "data.already_ordered": { "$some": { "name": "Aperol" } }
      },
      "evidence_kinds": ["calculation", "estimate", "fact", "missing"],
      "evidence": [
        { "kind": "calculation", "label": "Order Angelo Pinot Grigio", "value": "verified 10 bottle < par 12; target 24, shortfall 14, 3 case(s) = 18" },
        { "kind": "estimate", "label": "Estimated cost of Angelo Pinot Grigio", "value": "52.200 kr" },
        { "kind": "fact", "label": "Already on open orders", "value": "3 below-par items" },
        { "kind": "missing", "label": "Items that cannot be judged", "value": "24 with no par level, 2 with a par but no current count" }
      ],
      "records": ["inventory_item:@item.angelo", "inventory_item:@item.tanqueray", "inventory_item:@item.campari", "inventory_item:@item.eljimador", "inventory_item:@item.prosecco", "inventory_item:@item.tonic"],
      "records_exclude": ["inventory_item:@item.aperol", "inventory_item:@item.gull", "inventory_item:@item.limes"],
      "unknown": { "count": 26 }
    },
    "notes": "Aperol (Globus, ordered), Gull (Ölgerðin, arriving Friday) and Limes (Innnes, partially received) are already on order."
  },
